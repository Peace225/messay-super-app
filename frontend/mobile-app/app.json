
{
  "expo": {
    "name": "MESSAY",
    "slug": "messay-super-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/logo-square.png",
    "scheme": "messay",
    "owner": "bradfal",

    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },

    "assetBundlePatterns": [
      "assets/**/*"
    ],

    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.messay.tricycle",
      "buildNumber": "1",

      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "MESSAY a besoin de ta position pour trouver un tricycle près de toi à Abidjan.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "MESSAY utilise ta position pour assurer le suivi de tes courses en temps réel, y compris en arrière-plan lorsque cette autorisation est activée.",
        "NSCameraUsageDescription": "MESSAY utilise la caméra pour scanner les QR codes de paiement.",

        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification"
        ]
      },

      "config": {
        "googleMapsApiKey": "REMPLACER_PAR_VOTRE_CLE_GOOGLE_MAPS_IOS"
      }
    },

    "android": {
      "package": "com.messay.tricycle",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",

      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-square.png",
        "backgroundColor": "#FF6B35",
        "monochromeImage": "./assets/logo-square.png"
      },

      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK"
      ],

      "config": {
        "googleMaps": {
          "apiKey": "REMPLACER_PAR_VOTRE_CLE_GOOGLE_MAPS_ANDROID"
        }
      },

      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "messay"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },

    "plugins": [
      "expo-router",

      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png"
        }
      ],

      "@react-native-firebase/app",

      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "MESSAY utilise ta position pour trouver les tricycles les plus proches.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],

      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],

      "@react-native-community/datetimepicker",

      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": [],
          "enableGooglePay": false
        }
      ],

      "expo-sharing"
    ],

    "extra": {
      "router": {
        "origin": false
      },

      "eas": {
        "projectId": "3243e067-efa6-40ed-b4cd-a8dc6782e23c"
      }
    }
  }
}
